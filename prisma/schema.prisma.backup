generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DIRECTOR
  TEACHER
  STAFF
  PARENT
  STUDENT
  GUEST

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  WITHDRAWN

  @@map("user_status")
}

enum StudentStatus {
  ENROLLED
  PAUSED
  WITHDRAWN

  @@map("student_status")
}

model User {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String   @unique
  name            String
  imageUrl        String?  @map("image_url")
  role            UserRole @default(GUEST)
  status          UserStatus @default(ACTIVE)
  permissions     Json     @default("{}")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz

  oauthAccounts   OAuthAccount[]
  studentProfile  Student?
  parentLinks     ParentStudentLink[] @relation("ParentLinks")
  linksCreated    ParentStudentLink[] @relation("LinksCreated")
  linksEnded      ParentStudentLink[] @relation("LinksEnded")

  @@map("users")
}

model OAuthAccount {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String  @default("oauth")
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model Student {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?       @unique @map("user_id") @db.Uuid
  name          String
  schoolName    String?       @map("school_name")
  grade         String?
  phone         String?
  status        StudentStatus @default(ENROLLED)
  enrolledAt    DateTime      @default(now()) @map("enrolled_at") @db.Date
  withdrawnAt   DateTime?     @map("withdrawn_at") @db.Timestamptz
  viewExpiresAt DateTime?     @map("view_expires_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @default(now()) @map("updated_at") @db.Timestamptz

  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  parentLinks ParentStudentLink[]

  @@map("students")
}

model ParentStudentLink {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentUserId String    @map("parent_user_id") @db.Uuid
  studentId    String    @map("student_id") @db.Uuid
  linkedBy     String?   @map("linked_by") @db.Uuid
  linkedAt     DateTime  @default(now()) @map("linked_at") @db.Timestamptz
  endedAt      DateTime? @map("ended_at") @db.Timestamptz
  endedBy      String?   @map("ended_by") @db.Uuid
  endReason    String?   @map("end_reason")

  parent  User    @relation("ParentLinks", fields: [parentUserId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  creator User?   @relation("LinksCreated", fields: [linkedBy], references: [id], onDelete: SetNull)
  ender   User?   @relation("LinksEnded", fields: [endedBy], references: [id], onDelete: SetNull)

  @@index([parentUserId, studentId])
  @@map("parent_student_links")
}

// 전체 MVP 테이블 생성과 부분 고유 인덱스는 prisma/sql/schema.sql에 정의되어 있습니다.
// Prisma Client를 연결할 때 나머지 모델은 `prisma db pull`로 동기화합니다.
